# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/survey_app?schema=public"

# JWT secrets (change in production!)
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"

# Token expiry
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

# Server
PORT=3001
NODE_ENV=development

# CORS origin (frontend URL, comma-separated for multiple)
CORS_ORIGIN="http://localhost:5173"
# Production: CORS_ORIGIN="https://your-app.vercel.app,https://www.your-app.vercel.app"

# OTP (dev mode uses fixed OTP, prod uses SMS service)
DEV_OTP="123456"

# Upload directory
UPLOAD_DIR="uploads"
