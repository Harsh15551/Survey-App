// Prisma schema for Veerbhadreshwar Trust Survey App
// PostgreSQL 16 | houseCode as primary key for Household

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  SUPERVISOR
  FIELD_AGENT
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum HouseholdStatus {
  VERIFIED
  FLAGGED
}

enum GrievanceStatus {
  OPEN
  RESOLVED
}

enum District {
  GULBARGA
  BIDAR
}

enum PropertyType {
  OWN_HOUSE
  RENTED_HOUSE
  GOVERNMENT_PROVIDED_HOUSE
  OTHERS
}

enum FamilySizeBand {
  ONE_TO_THREE
  FOUR_TO_SIX
  SEVEN_TO_TEN
  ABOVE_TEN
}

enum IncomeBracket {
  BELOW_5000
  BETWEEN_5_10K
  BETWEEN_10_20K
  BETWEEN_20_50K
  BETWEEN_50_100K
  ABOVE_100K
}

enum Occupation {
  AGRICULTURE
  DAILY_WAGE
  GOVT_SERVICE
  PRIVATE_SERVICE
  BUSINESS
  UNEMPLOYED
  OTHER
}

enum ProblemOption {
  WATER_SUPPLY
  POWER_SUPPLY
  ROAD_INFRA
  HEALTHCARE
  EDUCATION
  DRAINAGE
  UNEMPLOYMENT
  CONNECTIVITY
  OTHERS
}

enum FacilityOption {
  DRINKING_WATER
  ELECTRICITY
  LPG_GAS
  DRAINAGE_SEWAGE
  NONE
}

enum GovtSchemeOption {
  HOUSING_SCHEME
  PENSION_SCHEME
  RATION_CARD
  SCHOLARSHIP
  HEALTH_INSURANCE
  OTHERS
}

// ---------------------------------------------------------------------------
// User (Admin / Supervisor / Field Agent)
// ---------------------------------------------------------------------------

model User {
  id           String        @id @default(cuid())
  name         String
  phone        String        @unique
  passwordHash String        @map("password_hash")
  role         Role
  region       String
  status       AccountStatus @default(ACTIVE)
  plainPassword String?       @map("plain_password")

  supervisorId String? @map("supervisor_id")
  supervisor   User?   @relation("SupervisorAgents", fields: [supervisorId], references: [id])
  agents       User[]  @relation("SupervisorAgents")

  households Household[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ---------------------------------------------------------------------------
// Household — houseCode is the PRIMARY KEY
// ---------------------------------------------------------------------------

model Household {
  houseCode String @id @map("house_code")

  headName      String  @map("head_name")
  phone         String
  email         String?
  alternatePhone String? @map("alternate_phone")

  state         String  @default("Karnataka")
  propertyType  PropertyType @map("property_type")
  district      District
  taluk         String
  villageName   String  @map("village_name")
  wardPanchayat String  @map("ward_panchayat")
  houseNumber   String  @map("house_number")

  headAge         Int           @map("head_age")
  familySizeBand  FamilySizeBand @map("family_size_band")
  familySize      Int?          @map("family_size")
  occupation      Occupation
  incomeBracket   IncomeBracket @map("income_bracket")

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  photoUrl String? @map("photo_url")

  fieldAgentId String @map("field_agent_id")
  fieldAgent   User   @relation(fields: [fieldAgentId], references: [id])

  facilities           FacilityOption[]
  problems             ProblemOption[]
  grievanceDescription String?          @map("grievance_description") @db.Text
  govtSchemesAvailed   GovtSchemeOption[] @map("govt_schemes_availed")

  citizenPasswordHash String @map("citizen_password_hash")

  status HouseholdStatus @default(VERIFIED)

  grievances Grievance[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([district, taluk])
  @@map("households")
}

// ---------------------------------------------------------------------------
// Grievance (citizen-submitted complaints)
// ---------------------------------------------------------------------------

model Grievance {
  id        String          @id @default(cuid())
  houseCode String          @map("house_code")
  household Household       @relation(fields: [houseCode], references: [houseCode])
  message   String          @db.Text
  status    GrievanceStatus @default(OPEN)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([houseCode])
  @@index([status])
  @@map("grievances")
}

// ---------------------------------------------------------------------------
// Audit Log
// ---------------------------------------------------------------------------

model AuditLog {
  id       String  @id @default(cuid())
  userId   String? @map("user_id")
  action   String
  entity   String
  entityId String? @map("entity_id")
  before   Json?
  after    Json?
  ip       String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}
